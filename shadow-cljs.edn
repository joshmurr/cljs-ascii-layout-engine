{:builds
 {:app {:asset-path "/js"
        :devtools {:reload-strategy :full}
        :modules {:invoice {:depends-on #{:shared}
                            :entries [app.invoice]
                            :init-fn app.invoice/init}
                  :main {:depends-on #{:shared}
                         :entries [app.core]
                         :init-fn app.core/init}
                  :shared {:entries []}}
        :output-dir "public/js"
        :target :browser}}
 :dependencies []
 :dev-http {8080 "public"}
 :source-paths ["src"]}
