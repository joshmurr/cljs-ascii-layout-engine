{:builds
 {:app {:asset-path "/js"
        :build-hooks [(build.pages/emit)]
        :devtools {:reload-strategy :full}
        :modules {:dividends {:depends-on #{:shared}
                              :entries [app.dividends]
                              :init-fn app.dividends/init}
                  :invoice {:depends-on #{:shared}
                            :entries [app.invoice]
                            :init-fn app.invoice/init}
                  :main {:depends-on #{:shared}
                         :entries [app.core]
                         :init-fn app.core/init}
                  :shared {:entries [app.example.data app.storage]}}
        :output-dir "public/js"
        :target :browser}}
 :dependencies [[hiccup "2.0.0"]]
 :dev-http {8080 "public"}
 :source-paths ["src"]}
